# FieldSync application PostgreSQL
FIELDSYNC_DB_NAME=fieldsync_dev
FIELDSYNC_DB_USER=fieldsync_app
FIELDSYNC_DB_PASSWORD=change-me

# Restricted Spring runtime PostgreSQL role
FIELDSYNC_RUNTIME_DB_USER=fieldsync_runtime
FIELDSYNC_RUNTIME_DB_PASSWORD=change-me

# Keycloak PostgreSQL
KEYCLOAK_DB_NAME=keycloak_dev
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=change-me

# Local Keycloak administration
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# OpenBao local development
OPENBAO_DEV_ROOT_TOKEN=change-me

# OpenBao Agent AppRole
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=